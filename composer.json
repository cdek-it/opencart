{
  "name": "cdek/opencart-delivery-dev",
  "description": "Dev tooling for the CDEK OpenCart 3 module",
  "type": "project",
  "license": "proprietary",
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload-dev": {
    "psr-4": {
      "CDEK\\": "upload/system/library/cdek_official/src",
      "CDEK\\Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit -c .ci/phpunit.xml",
    "lint": "bash .ci/bin/phpcs-diff.sh",
    "lint-full": "phpcs --standard=.ci/phpcs.xml",
    "stan": "phpstan analyse -c .ci/phpstan.neon --memory-limit=1536M"
  }
}
