# Порт, на котором приложение будет доступно на хосте (http://localhost:APP_PORT)
APP_PORT=8080

# MySQL
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=opencart
MYSQL_USER=opencart
MYSQL_PASSWORD=opencart

# Учётка администратора OpenCart, создаётся при первом запуске (oc-up)
OC_ADMIN_USERNAME=admin
OC_ADMIN_PASSWORD=admin
OC_ADMIN_EMAIL=admin@example.local
